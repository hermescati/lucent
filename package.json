{
  "name": "expo-lucent",
  "version": "0.1.0",
  "description": "iOS 26 Liquid Glass for Expo and React Native: Apple's native glass, tab bar and search on iOS, a matching recreation on Android",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "expo-source": "./src/index.ts",
        "default": "./build/index.d.ts"
      },
      "expo-source": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./navigation": {
      "types": {
        "expo-source": "./src/navigation.ts",
        "default": "./build/navigation.d.ts"
      },
      "expo-source": "./src/navigation.ts",
      "default": "./build/navigation.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "navigation": [
        "./build/navigation.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "compare": "node internal/compare.js",
    "check:package": "publint --level error && attw --pack . --ignore-rules unexpected-module-syntax",
    "changeset": "changeset",
    "release": "changeset publish",
    "version-packages": "changeset version && npm install --package-lock-only"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-router",
    "liquid-glass",
    "ios-26",
    "glass",
    "glassmorphism",
    "glass-effect",
    "blur",
    "refraction",
    "tab-bar",
    "native-tabs",
    "bottom-tabs",
    "floating-tab-bar",
    "search-bar",
    "ios-style",
    "cupertino",
    "android",
    "ui",
    "components",
    "expo-lucent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermescati/lucent.git"
  },
  "bugs": {
    "url": "https://github.com/hermescati/lucent/issues"
  },
  "author": "hermescati <hermescati99@gmail.com> (https://github.com/hermescati)",
  "license": "MIT",
  "homepage": "https://github.com/hermescati/lucent#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.26.0",
    "@changesets/cli": "^3.0.3",
    "@expo/ui": "~58.0.20",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.15",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "^58.0.11",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-router": "~58.0.23",
    "expo-symbols": "~58.0.4",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.11",
    "pngjs": "^7.0.0",
    "prettier": "^3.0.0",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-keyboard-controller": "^1.22.7",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-worklets": "^0.13.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "@expo/ui": ">=58.0.0",
    "expo": ">=58.0.0",
    "expo-glass-effect": ">=58.0.0",
    "expo-haptics": ">=58.0.0",
    "expo-router": ">=58.0.0",
    "expo-symbols": ">=58.0.0",
    "react": ">=19.3.0",
    "react-native": ">=0.88.0",
    "react-native-gesture-handler": ">=3.3.0",
    "react-native-keyboard-controller": ">=1.22.0",
    "react-native-reanimated": ">=4.7.0",
    "react-native-safe-area-context": ">=5.10.0",
    "react-native-screens": ">=4.30.0",
    "react-native-svg": ">=15.16.0",
    "react-native-worklets": ">=0.13.0"
  },
  "peerDependenciesMeta": {
    "expo-router": {
      "optional": true
    },
    "react-native-keyboard-controller": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-screens": {
      "optional": true
    }
  },
  "react-native": "src/index",
  "files": [
    "build",
    "src",
    "android",
    "ios",
    "expo-module.config.json",
    "README.md",
    "CHANGELOG.md",
    "!**/__tests__",
    "!android/build",
    "!android/.gradle"
  ]
}
